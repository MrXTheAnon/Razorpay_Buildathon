# ==============================================================================
# RazorLoop Configuration Template
# Copy this file to infra/.env and fill in your credentials.
# ==============================================================================

# Razorpay Test API Credentials (from https://dashboard.razorpay.com/#/app/keys)
RAZORPAY_KEY_ID="rzp_test_yourKeyIdHere"
RAZORPAY_KEY_SECRET="yourKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="whsec_yourWebhookSecretHere"

# Telegram Bot Integration (create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN="1234567890:ABCDefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_DEMO_CHAT_ID=""

# Database Connection (auto-falls back to SQLite dev.db if PostgreSQL is unset)
DATABASE_URL="sqlite+aiosqlite:///./dev.db"

# Optional LLM / Gateway Keys (OmniRoute / OpenAI)
OMNIROUTE_BASE_URL="http://127.0.0.1:20128/v1"
OMNIROUTE_API_KEY="your_omniroute_key_or_leave_blank"
OMNIROUTE_MODEL="github/gpt-4o-mini"
OPENAI_API_KEY=""

# Application Host URL (for local network / mobile browser checkout)
APP_HOST_URL="http://localhost:8000"
